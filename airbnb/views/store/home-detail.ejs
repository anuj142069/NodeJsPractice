<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-6xl">
      <h2 class="text-3xl text-red-500 font-bold text-center mb-6">
        You are is home detail page:
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="rounded-lg overflow-hidden">
          <img src="<%= home.photoUrl %>" alt="<%= home.name %>" class="w-full h-96 object-cover">
        </div>
      </div>
      <div class="space-y-6">
        <div class="border-b pb-4">
          <h3 class="text-2xl font-semibold">Description</h3>
          <p class="text-gray-600"><%= home.description %></p>
        </div>
        <div class="border-b pb-4">
          <h3 class="text-2xl font-semibold">Location</h3>
          <p class="text-gray-600"><%= home.location %></p>
        </div>
        <div class="border-b pb-4">
          <h3 class="text-2xl font-semibold">Rating</h3>
          <div class="flex">
            <span class="text-yellow-400 text-xl">*</span>
            <span class="ml-2 text-xl"><%= home.rating %> / 5</span>
          </div>
        </div>
        <div>
          <%- include('../partials/favourite') %>
        </div>
      </div>
    </main>
  </body>
</html>
